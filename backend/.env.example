# Copy this file to .env and adjust the values. Never commit .env.
# Real secrets (if you ever add any) belong only in .env or your host's settings.

# development | test | production (default: development)
NODE_ENV=development

# Port the API listens on (default: 4000)
PORT=4000

# Prisma connection string (required). The database is created by `npm run setup`.
# SQLite: the file path is relative to prisma/schema.prisma, so this is backend/prisma/dev.db.
# Use a path on persistent storage in production.
DATABASE_URL="file:./dev.db"

# Origin(s) of the frontend allowed by CORS. Use a comma-separated list for several.
# Optional in development (defaults to http://localhost:3000); required when NODE_ENV=production.
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# --- AI task generation (optional) ---
# Server-side only: this key is read by the backend and is never sent to the browser.
# Never commit it, never put it in a NEXT_PUBLIC_* variable. Leave blank to disable the feature
# (POST /api/ai/generate-tasks then answers 503 AI_NOT_CONFIGURED; the rest of the API is unaffected).
# Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Model used for task generation (default: gemini-3.1-flash-lite, available on the free tier).
# GEMINI_MODEL=gemini-3.1-flash-lite
# Optional. Override only for a proxy or a test double (default: https://generativelanguage.googleapis.com).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
